{
  "name": "goose-on-the-go",
  "main": "index.ts",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package && node scripts/patch-expo-fetch.cjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "expo start",
    "dev": "expo start --dev-client --clear",
    "build": "bash scripts/release-build.sh",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "audit": "node scripts/audit-check.mjs --threshold high",
    "build:network": "scripts/build-embedded-network.sh",
    "build:ear": "scripts/build-embedded-ear.sh",
    "check:prebuild": "scripts/check-prebuild.sh",
    "bump-build": "node scripts/bump-build.mjs",
    "check-icons": "node scripts/sweep-icons.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/quicksand": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@jarida/ink": "^1.1.0",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-media-library": "~57.0.6",
    "expo-notifications": "~57.0.23",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "i18next": "^27.2.2",
    "lucide-react-native": "^1.47.0",
    "marked": "^18.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-native-zeroconf": "^0.14.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-i18next": "^6.1.5",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@noble|@jarida|marked))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^expo-modules-core/(.*)$": [
        "<rootDir>/node_modules/expo/node_modules/expo-modules-core/$1",
        "<rootDir>/node_modules/expo-modules-core/$1"
      ],
      "^expo-modules-core$": [
        "<rootDir>/node_modules/expo/node_modules/expo-modules-core",
        "<rootDir>/node_modules/expo-modules-core"
      ]
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/support/",
      "/android/",
      "/ios/",
      "/\\.(worktrees|claude)/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "overrides": {
    "browserslist": "^4.29.0",
    "js-yaml@4": "^4.3.2",
    "nanoid": "^3.3.19",
    "postcss": "^8.5.28",
    "shell-quote": "^1.11.0",
    "ws@7": "^7.5.13",
    "brace-expansion@5": "^5.0.12",
    "minimatch@3": {
      "brace-expansion": "^2.0.2"
    },
    "@expo/plist": {
      "@xmldom/xmldom": "^0.8.15"
    },
    "plist": {
      "@xmldom/xmldom": "^0.9.12"
    },
    "source-map-js": "^1.2.2"
  },
  "allowScripts": {
    "@shopify/react-native-skia@2.6.2": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
